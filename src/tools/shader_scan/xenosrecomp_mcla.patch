+float pwlGammaToLinear(float gamma)
+{
+    gamma = saturate(gamma);
+    float scale;
+    float offset;
+    if (gamma >= 192.0 / 255.0) { scale = 8.0 / 1024.0; offset = -1024.0; }
+    else if (gamma >= 96.0 / 255.0) { scale = 4.0 / 1024.0; offset = -256.0; }
+    else if (gamma >= 64.0 / 255.0) { scale = 2.0 / 1024.0; offset = -64.0; }
+    else { scale = 1.0 / 1024.0; offset = 0.0; }
+    float result = gamma * ((255.0 * 1024.0) * scale) + offset;
+    result += trunc(result * scale);
+    return result * (1.0 / 1023.0);
+}
