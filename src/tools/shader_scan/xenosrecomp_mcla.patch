+uint32_t LoadBe32(const uint8_t* p)
+{
+    return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | uint32_t(p[3]);
+}
+
+uint64_t Fnv1a64(const uint8_t* data, size_t size)
+{
+    uint64_t hash = 0xCBF29CE484222325ull;
+    for (size_t i = 0; i < size; ++i)
+    {
+        hash ^= data[i];
+        hash *= 0x100000001B3ull;
+    }
+    return hash;
+}
+
+uint64_t ShaderIdentity(const uint8_t* code, size_t size)
+{
+    std::vector<uint8_t> normalized(code, code + size);
+    const size_t dwordCount = size / 4;
+    struct Exec { uint32_t address, count, sequence; };
+    std::vector<Exec> execs;
+    size_t limit = dwordCount;
+    for (size_t i = 0; i + 2 < limit; i += 3)
+    {
+        const uint32_t d0 = LoadBe32(normalized.data() + i * 4);
+        const uint32_t d1 = LoadBe32(normalized.data() + (i + 1) * 4);
+        const uint32_t d2 = LoadBe32(normalized.data() + (i + 2) * 4);
+        const uint32_t w0[] = {d0, (d1 >> 16) | (d2 << 16)};
+        const uint32_t w1[] = {d1 & 0xFFFFu, d2 >> 16};
+        for (size_t k = 0; k < 2; ++k)
+        {
+            const uint32_t opcode = (w1[k] >> 12) & 0xF;
+            if (!((opcode >= 1 && opcode <= 7) || opcode == 13 || opcode == 14)) continue;
+            const uint32_t address = w0[k] & 0xFFF;
+            if (address && size_t(address) * 3 < limit) limit = size_t(address) * 3;
+            if (address) execs.push_back({address, (w0[k] >> 12) & 7u, (w0[k] >> 16) & 0xFFFu});
+        }
+    }
+    for (const Exec& exec : execs)
+    {
+        const uint32_t execCount = exec.count < 6u ? exec.count : 6u;
+        for (uint32_t i = 0; i < execCount; ++i)
+        {
+            if (((exec.sequence >> (i * 2)) & 1u) == 0) continue;
+            const size_t base = (size_t(exec.address) + i) * 3;
+            if (base + 2 >= dwordCount) continue;
+            const uint32_t word0 = LoadBe32(normalized.data() + base * 4);
+            if ((word0 & 0x1Fu) != 0) continue;
+            normalized[base * 4 + 0] = normalized[base * 4 + 1] = 0;
+            normalized[base * 4 + 2] = normalized[base * 4 + 3] = 0;
+            std::fill(normalized.begin() + (base + 1) * 4, normalized.begin() + (base + 3) * 4, 0);
+        }
+    }
+    return Fnv1a64(normalized.data(), normalized.size());
+}
+
+struct MspkShader
+{
+    uint64_t identity = 0;
+    bool pixel = false;
+    std::vector<uint8_t> container;
+    std::vector<uint32_t> vertexElements;
+    uint8_t specMask = 0;
+    std::vector<uint8_t> dxil0;
+    std::vector<uint8_t> dxil1;
+    bool valid = false;
+};
+
+#pragma pack(push, 1)
+struct MspkHeader { char magic[4]; uint32_t version, count, reserved; };
+struct MspkEntry
+{
+    uint64_t key;
+    uint8_t stage, specMask;
+    uint16_t vertexElementCount;
+    uint32_t offset0, size0, offset1, size1;
+    uint64_t fnv0, fnv1;
+    uint32_t vertexElementOffset;
+};
+#pragma pack(pop)
+static_assert(sizeof(MspkEntry) == 48);
+
+bool AddMspkContainer(std::map<uint64_t, MspkShader>& shaders, const uint8_t* data, size_t available)
+{
+    if (available < sizeof(ShaderContainer)) return false;
+    const auto* container = reinterpret_cast<const ShaderContainer*>(data);
+    const size_t total = size_t(container->virtualSize) + size_t(container->physicalSize);
+    if ((container->flags & 0xFFFFFF00) != 0x102A1100 || total < sizeof(ShaderContainer) ||
+        total > available || container->field1C != 0 || container->field20 != 0 ||
+        container->shaderOffset == 0 || size_t(container->shaderOffset) + sizeof(Shader) > size_t(container->virtualSize))
+        return false;
+    const auto* shader = reinterpret_cast<const Shader*>(data + container->shaderOffset);
+    const size_t codeOffset = size_t(container->virtualSize) + size_t(shader->physicalOffset);
+    const size_t codeSize = shader->size;
+    if (!codeSize || codeSize > 65536 || codeOffset > total || codeSize > total - codeOffset) return false;
+    const uint64_t identity = ShaderIdentity(data + codeOffset, codeSize);
+    const bool pixel = (container->flags & 1) == 0;
+    std::vector<uint32_t> elements;
+    if (!pixel)
+    {
+        const auto* vertex = reinterpret_cast<const VertexShader*>(shader);
+        if (vertex->vertexElementCount > 64) return false;
+        for (uint32_t i = 0; i < vertex->vertexElementCount; ++i)
+            elements.push_back(vertex->vertexElementsAndInterpolators[vertex->field18 + i].get() & 0xFFFFFu);
+    }
+    auto [it, inserted] = shaders.try_emplace(identity);
+    if (!inserted)
+    {
+        if (it->second.pixel != pixel || it->second.vertexElements != elements)
+            fmt::println(stderr, "MSPK identity {:016X} has incompatible container metadata", identity);
+        return true;
+    }
+    it->second.identity = identity;
+    it->second.pixel = pixel;
+    it->second.container.assign(data, data + total);
+    it->second.vertexElements = std::move(elements);
+    return true;
+}
+
+int BuildMspk(const char* input, const char* output, const char* includeInput)
+{
+    size_t includeSize = 0;
+    auto includeData = readAllBytes(includeInput, includeSize);
+    std::string_view include(reinterpret_cast<const char*>(includeData.get()), includeSize);
+    std::vector<std::filesystem::path> paths;
+    for (const auto& file : std::filesystem::recursive_directory_iterator(input))
+        if (!file.is_directory()) paths.push_back(file.path());
+    std::sort(paths.begin(), paths.end());
+
+    std::map<uint64_t, MspkShader> shaderMap;
+    for (const auto& path : paths)
+    {
+        size_t fileSize = 0;
+        auto bytes = readAllBytes(path.string().c_str(), fileSize);
+        for (size_t offset = 0; offset + sizeof(ShaderContainer) <= fileSize;)
+        {
+            const auto* candidate = reinterpret_cast<const ShaderContainer*>(bytes.get() + offset);
+            const size_t total = size_t(candidate->virtualSize) + size_t(candidate->physicalSize);
+            if (AddMspkContainer(shaderMap, bytes.get() + offset, fileSize - offset) &&
+                total >= sizeof(ShaderContainer) && total <= fileSize - offset)
+                offset += total;
+            else
+                ++offset;
+        }
+    }
+    fmt::println("MSPK: {} normalized shader identities", shaderMap.size());
+    std::vector<MspkShader*> shaders;
+    for (auto& [identity, shader] : shaderMap) shaders.push_back(&shader);
+    std::atomic<uint32_t> completed = 0;
+    std::atomic<uint32_t> failures = 0;
+    std::for_each(std::execution::par, shaders.begin(), shaders.end(), [&](MspkShader* shader)
+    {
+        ShaderRecompiler recompiler;
+        recompiler.recompile(shader->container.data(), include);
+        shader->specMask = uint8_t(recompiler.specConstantsMask & (shader->pixel ? 2u : 1u));
+        thread_local DxcCompiler compiler;
+        auto compileVariant = [&](uint32_t mask, std::vector<uint8_t>& destination)
+        {
+            std::string source = recompiler.out;
+            source += fmt::format("\nuint g_SpecConstants() {{ return {}; }}\n", mask);
+            IDxcBlob* blob = compiler.compile(source, recompiler.isPixelShader, false, false);
+            if (!blob) return false;
+            const auto* begin = reinterpret_cast<const uint8_t*>(blob->GetBufferPointer());
+            destination.assign(begin, begin + blob->GetBufferSize());
+            blob->Release();
+            return destination.size() >= 4 && std::memcmp(destination.data(), "DXBC", 4) == 0;
+        };
+        bool ok = compileVariant(0, shader->dxil0);
+        if (ok && shader->specMask) ok = compileVariant(shader->specMask, shader->dxil1);
+        shader->valid = ok;
+        if (!ok) ++failures;
+        const uint32_t done = ++completed;
+        if ((done % 100) == 0 || done == shaders.size())
+            fmt::println("MSPK compiling: {}/{}", done, shaders.size());
+    });
+    if (failures)
+    {
+        fmt::println(stderr, "MSPK: {} shader identities failed compilation", failures.load());
+        return 2;
+    }
+
+    std::vector<uint8_t> file(sizeof(MspkHeader) + shaders.size() * sizeof(MspkEntry), 0);
+    std::vector<MspkEntry> entries(shaders.size());
+    auto align4 = [&] { while (file.size() & 3u) file.push_back(0); };
+    auto append = [&](const void* data, size_t size)
+    {
+        align4();
+        const uint32_t offset = uint32_t(file.size());
+        const auto* bytes = reinterpret_cast<const uint8_t*>(data);
+        file.insert(file.end(), bytes, bytes + size);
+        return offset;
+    };
+    for (size_t i = 0; i < shaders.size(); ++i)
+    {
+        const MspkShader& shader = *shaders[i];
+        MspkEntry& entry = entries[i];
+        entry.key = shader.identity;
+        entry.stage = shader.pixel ? 'p' : 'v';
+        entry.specMask = shader.specMask;
+        entry.vertexElementCount = uint16_t(shader.vertexElements.size());
+        if (!shader.vertexElements.empty())
+            entry.vertexElementOffset = append(shader.vertexElements.data(), shader.vertexElements.size() * 4);
+        entry.offset0 = append(shader.dxil0.data(), shader.dxil0.size());
+        entry.size0 = uint32_t(shader.dxil0.size());
+        entry.fnv0 = Fnv1a64(shader.dxil0.data(), shader.dxil0.size());
+        if (!shader.dxil1.empty())
+        {
+            entry.offset1 = append(shader.dxil1.data(), shader.dxil1.size());
+            entry.size1 = uint32_t(shader.dxil1.size());
+            entry.fnv1 = Fnv1a64(shader.dxil1.data(), shader.dxil1.size());
+        }
+    }
+    MspkHeader header{{'M','S','P','K'}, 2, uint32_t(entries.size()), 0};
+    std::memcpy(file.data(), &header, sizeof(header));
+    std::memcpy(file.data() + sizeof(header), entries.data(), entries.size() * sizeof(MspkEntry));
+    const std::string temporary = std::string(output) + ".tmp";
+    writeAllBytes(temporary.c_str(), file.data(), file.size());
+    std::filesystem::rename(temporary, output);
+    fmt::println("MSPK written: {} entries, {:.1f} MB", entries.size(), file.size() / 1000000.0);
+    return 0;
+}
