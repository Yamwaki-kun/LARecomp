+float3 blendPremultRgb(uint mode, float4 source, float4 blendConstant)
+{
+    switch (mode)
+    {
+    case 1: return 0.0;
+    case 2: return source.rgb;
+    case 3: return 1.0 - source.rgb;
+    case 4: return source.aaa;
+    case 5: return 1.0 - source.aaa;
+    case 6: return blendConstant.rgb;
+    case 7: return 1.0 - blendConstant.rgb;
+    case 8: return blendConstant.aaa;
+    case 9: return 1.0 - blendConstant.aaa;
+    default: return 1.0;
+    }
+}
+
+float blendPremultAlpha(uint mode, float4 source, float4 blendConstant)
+{
+    switch (mode)
+    {
+    case 1: return 0.0;
+    case 2: case 4: return source.a;
+    case 3: case 5: return 1.0 - source.a;
+    case 6: case 8: return blendConstant.a;
+    case 7: case 9: return 1.0 - blendConstant.a;
+    default: return 1.0;
+    }
+}
+
+void applyBlendPremult(inout float4 color, uint rgbMode, uint alphaMode, float4 blendConstant)
+{
+    const float4 source = color;
+    color.rgb *= blendPremultRgb(rgbMode, source, blendConstant);
+    color.a *= blendPremultAlpha(alphaMode, source, blendConstant);
